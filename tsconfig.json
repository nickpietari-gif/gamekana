{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["content/src/**/*.ts", "learning/src/**/*.ts", "progress/src/**/*.ts", "shared/src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
